---
layout: base.njk
---
{% block content %}
{#
  Dynamic news index.

  Articles are read from the Eleventy collection instead of pre-generated HTML,
  so an article added through the CMS — or through /admin/publish.html, which
  writes all 14 languages in one commit — appears here automatically, in every
  language, without running a generator script.

  Ordering: the whole list is sorted newest-first by `newsDate`, so the most
  recently published article is always at the top of the page — across every
  section. The section name is rendered as a small tag on each card for context
  only; it no longer splits the page into separate groups, which previously
  forced older "Company News" items above a newer article that happened to live
  in a later section.
#}
{% set langCode = lang or site.defaultLang %}
{% set articles = [] %}
{% for item in collections.all %}
  {% if item.data.lang == langCode and item.data.newsSlug %}
    {% set _ = articles.push(item) %}
  {% endif %}
{% endfor %}
{% set articles = articles | sort(attribute="data.newsDate", reverse=true) %}
<section class="container page">
  <h1>{{ title }}</h1>
  <div class="news-grid">
    {% for a in articles %}
    <article class="news-card">
      {% if a.data.newsSection %}<p class="news-card-section">{{ a.data.newsSection }}</p>{% endif %}
      <h3 class="news-card-title"><a href="{{ a.url }}">{{ a.data.title }}</a></h3>
      {% if a.data.newsDate %}
      <p class="news-card-date">{{ a.data.newsDate }}</p>
      {% endif %}
      <p class="news-card-desc">{{ a.data.description }}</p>
    </article>
    {% endfor %}
  </div>
</section>
<style>
  .news-card-section {
    display: inline-block;
    margin: 0 0 .5rem;
    padding: .15rem .55rem;
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.4;
    color: #0b4f8a;
    background: #e7f0f8;
    border-radius: 999px;
  }
</style>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ title | tojson | safe }},
  "description": {{ description | tojson | safe }},
  "url": "https://{{ site.domain | safe }}/{{ langCode | safe }}/news/",
  "inLanguage": "{{ langCode | safe }}",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ articles.length | safe }},
    "itemListElement": [
      {% for a in articles %}
      {
        "@type": "ListItem",
        "position": {{ loop.index | safe }},
        "name": {{ a.data.title | tojson | safe }},
        "url": "https://{{ site.domain | safe }}{{ a.url | safe }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
}
</script>
{% endblock %}
