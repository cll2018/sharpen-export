---
layout: base.njk
---
{% set s = i18n[lang] or i18n[site.fallbackLang] %}
<section class="hero">
  <div class="container">
    <h1>{{ heroTitle }}</h1>
    <p class="lead">{{ heroLead }}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="{{ ('/' + lang + '/products/') | langUrl(lang) }}">{{ s.view }}</a>
      <a class="btn btn-outline" href="{{ ('/' + lang + '/contact/') | langUrl(lang) }}">{{ s.quote }}</a>
    </div>
  </div>
</section>

<section class="container features">
  <h2>{{ s.core }}</h2>
  <div class="card-grid">
    {% set plist = products[lang] or products[site.fallbackLang] %}
    {% for p in plist %}
    <article class="card">
      <div class="card-img" style="background-image:url('{{ p.image }}')"></div>
      <h3>{{ p.name }}</h3>
      <p>{{ p.summary }}</p>
      <a class="card-link" href="{{ ('/' + lang + '/products/') | langUrl(lang) }}#{{ p.id }}">{{ s.learn }} →</a>
    </article>
    {% endfor %}
  </div>
</section>

<section class="container why">
  <h2>{{ s.why }}</h2>
  <ul class="why-list">
    <li>{{ s.why1 }}</li>
    <li>{{ s.why2 }}</li>
    <li>{{ s.why3 }}</li>
    <li>{{ s.why4 }}</li>
  </ul>
  <p class="cta-line">
    {{ s.project }}
    <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>
    ·
    <button id="chat-toggle-3" class="link-btn">💬 {{ s.ai }}</button>
  </p>
</section>
