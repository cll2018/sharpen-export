<!doctype html>
<html lang="{{ lang or site.defaultLang }}" dir="{{ 'rtl' if lang == 'ar' else 'ltr' }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }} — {{ site.name }}</title>
  <meta name="description" content="{{ description or site.name + ' — diamond/CBN grinding wheels, powder metallurgy high-speed steel, TiNiCo superalloy heat spreaders.' }}" />
  <link rel="canonical" href="{{ page.url | absUrl(site.domain) }}" />
  {% for l in site.langs %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ page.url | langUrl(l.code) | absUrl(site.domain) }}" />
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ '/en/' | absUrl(site.domain) }}" />
  <meta property="og:title" content="{{ title }} — {{ site.name }}" />
  <meta property="og:description" content="{{ description or 'Industrial grinding & advanced materials manufacturer.' }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ page.url | absUrl(site.domain) }}" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="{{ ('/' + lang + '/') | langUrl(lang) }}">
        <span class="brand-name">{{ site.shortName }}</span>
        <span class="brand-sub">{{ site.nameZh if (lang and lang.startsWith('zh')) else site.name }}</span>
      </a>
      <nav class="main-nav" aria-label="Primary">
        {% for item in site.nav %}
        <a href="{{ item | navUrl(lang) }}" class="{{ 'active' if page.url.startsWith(item | navUrl(lang)) else '' }}">{{ item | navLabel(lang) }}</a>
        {% endfor %}
      </nav>
      <div class="header-tools">
        <label class="lang-switch">
          <span class="visually-hidden">Language</span>
          <select id="lang-select" onchange="location.href=this.value">
            {% for l in site.langs %}
            <option value="{{ page.url | langUrl(l.code) }}" {{ 'selected' if l.code == lang }}>{{ l.native }}</option>
            {% endfor %}
          </select>
        </label>
        <a class="btn btn-whatsapp" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>
        <button id="chat-toggle" class="btn btn-chat" type="button" aria-expanded="false">💬 AI Chat</button>
      </div>
    </div>
  </header>

  <main>
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <h3>{{ site.nameZh if lang == 'zh' else site.name }}</h3>
        <p>{{ site.addressZh if (lang and lang.startsWith('zh')) else site.address }}</p>
        <p>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a> · Tel: {{ site.phone }}</p>
        <p>WeChat: {{ site.wechat }}</p>
      </div>
      <div>
        <h3>{{ '快速链接' if lang == 'zh' else 'Quick Links' }}</h3>
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item | navUrl(lang) }}">{{ item | navLabel(lang) }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h3>{{ '实时询盘' if lang == 'zh' else 'Real-time Inquiry' }}</h3>
        <p><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></p>
        <p><button id="chat-toggle-2" class="link-btn" type="button">💬 AI Chat</button></p>
        <p><a href="{{ ('/' + lang + '/contact/') | langUrl(lang) }}">{{ '提交询盘' if lang == 'zh' else 'Submit RFQ' }}</a></p>
      </div>
    </div>
    <div class="container copyright">
      © {{ site.name }}. {{ '保留所有权利。' if (lang and lang.startsWith('zh')) else 'All rights reserved.' }}
    </div>
  </footer>

  <!-- Floating WhatsApp button -->
  <a class="wa-float" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">WA</a>

  <!-- AI Chat widget (primary real-time channel) -->
  <div id="chat-panel" class="chat-panel" hidden>
    <div class="chat-head">
      <span>{{ 'AI 在线客服' if lang == 'zh' else 'AI Sales Assistant' }}</span>
      <span class="chat-head-btns">
        <button id="chat-min" class="chat-min" type="button" aria-label="Minimize">—</button>
        <button id="chat-close" class="chat-close" type="button" aria-label="Close">×</button>
      </span>
    </div>
    <div id="chat-body" class="chat-body">
      <div id="chat-log" class="chat-log"></div>
      <form id="chat-form" class="chat-form">
        <input id="chat-input" type="text" autocomplete="off" placeholder="{{ '输入您的问题…' if lang == 'zh' else 'Type your question…' }}" />
        <button type="submit">{{ '发送' if lang == 'zh' else 'Send' }}</button>
      </form>
    </div>
  </div>

  <script>window.__sharpenWhatsapp = "{{ site.whatsapp }}";</script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/chat.js"></script>
</body>
</html>
