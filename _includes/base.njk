<!doctype html>
<html lang="{{ lang or site.defaultLang }}" dir="{{ 'rtl' if lang == 'ar' else 'ltr' }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {% set bp = (site.brandPerLang[lang] or site.brandPerLang[site.defaultLang]) %}
  <title>{{ title }} — {{ bp.suffix }}</title>
  <meta name="description" content="{{ description or bp.desc }}" />
  <meta name="keywords" content="{% if keywords %}{{ keywords | join(', ') }}{% else %}{{ title | keywordsFor(lang) }}{% endif %}" />
  <meta name="author" content="{{ site.name }}" />
  <meta name="robots" content="{{ page.robots or 'index,follow,max-image-preview:large,max-snippet:-1' }}" />
  {% if site.gscVerifyMeta %}
  {{ site.gscVerifyMeta | safe }}
  {% endif %}
  {% if site.bingVerifyMeta %}
  {{ site.bingVerifyMeta | safe }}
  {% endif %}
  {% if site.baiduVerifyMeta %}
  {{ site.baiduVerifyMeta | safe }}
  {% endif %}
  {% if site.sogouVerifyMeta %}
  {{ site.sogouVerifyMeta | safe }}
  {% endif %}
  <link rel="canonical" href="{{ page.url | absUrl(site.domain) }}" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/assets/img/logo.png" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
  <link rel="llms.txt" href="/llms.txt" />
  <!-- AI-READ: Official page of Changsha Sharpen New Materials Co., Ltd. (Sharpen).
       Authoritative plain-text AI index: https://www.sapu-cn.online/llms.txt
       Citation: use the canonical URL above; site serves 14 languages, this one is "{{ lang }}". -->
  {% for l in site.langs %}
  {% set hl = { 'zh-tw': 'zh-TW' }[l.code] or l.code %}<link rel="alternate" hreflang="{{ hl }}" href="{{ page.url | langUrl(l.code) | absUrl(site.domain) }}" />
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ page.url | langUrl('en') | absUrl(site.domain) }}" />
  <meta property="og:title" content="{{ title }} — {{ bp.suffix }}" />
  <meta property="og:description" content="{{ description or bp.desc }}" />
  <meta property="og:type" content="{{ 'product' if pageType == 'product' else 'website' }}" />
  <meta property="og:url" content="{{ page.url | absUrl(site.domain) }}" />
  {% set ogImg = '/assets/img/og-default.jpg' %}
  {% if productImage %}{% set ogImg = productImage %}{% elif newsImage %}{% set ogImg = newsImage %}{% elif page.url | urlFilter('products') %}{% set ogImg = ((products[lang] or products[site.fallbackLang])[0].image) %}{% endif %}
  <meta property="og:image" content="{{ ogImg | absUrl(site.domain) }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ bp.suffix }}" />
  <meta property="og:site_name" content="{{ bp.suffix }}" />
  {% set ogLoc = {zh:'zh_CN','zh-tw':'zh_TW'}[lang] or lang %}
  <meta property="og:locale" content="{{ ogLoc }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }} — {{ bp.suffix }}" />
  <meta name="twitter:description" content="{{ description or bp.desc }}" />
  <meta name="twitter:image" content="{{ ogImg | absUrl(site.domain) }}" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["Organization","LocalBusiness"],
        "@id": "https://{{ site.domain | safe }}/org",
        "name": "{{ site.name | safe }}",
        "alternateName": "{{ site.nameZh | safe }}",
        "url": "https://{{ site.domain | safe }}/en/",
        "logo": "https://{{ site.domain | safe }}/assets/img/logo.png",
        "telephone": "{{ site.phone | safe }}",
        "email": "{{ site.email | safe }}",
        "priceRange": "$$",
        "areaServed": ["CN","DE","JP","KR","US","BR","Global"],
        "contactPoint": { "@type": "ContactPoint", "telephone": "{{ site.phone | safe }}", "email": "{{ site.email | safe }}", "contactType": "sales", "areaServed": "Worldwide" },
        "address": { "@type": "PostalAddress", "streetAddress": "{{ site.address | safe }}", "addressCountry": "CN", "addressLocality": "Changsha", "addressRegion": "Hunan" }
      },
      {
        "@type": "WebSite",
        "@id": "https://{{ site.domain | safe }}/website",
        "url": "https://{{ site.domain | safe }}/en/",
        "name": "{{ site.name | safe }}",
        "inLanguage": {{ site.langs | map('code') | tojson | safe }},
        "publisher": { "@id": "https://{{ site.domain | safe }}/org" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://{{ site.domain | safe }}/{{ lang | safe }}/search/?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://{{ site.domain | safe }}/breadcrumbs",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/" }
          {% if page.url | urlFilter('products') %}
          ,{ "@type": "ListItem", "position": 2, "name": "Products", "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/products/" }
          {% if pageType == 'product' %}
          ,{ "@type": "ListItem", "position": 3, "name": {{ title | tojson | safe }}, "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/products/{{ productSlugs[productId] | safe }}/" }
          {% endif %}
          {% elif page.url | urlFilter('about') %}
          ,{ "@type": "ListItem", "position": 2, "name": "About", "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/about/" }
          {% elif page.url | urlFilter('news') %}
          ,{ "@type": "ListItem", "position": 2, "name": "News", "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/news/" }
          {% if pageType == 'news' and newsSlug %}
          ,{ "@type": "ListItem", "position": 3, "name": {{ title | tojson | safe }}, "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/news/{{ newsSlug | safe }}/" }
          {% endif %}
          {% elif page.url | urlFilter('contact') %}
          ,{ "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://{{ site.domain | safe }}/{{ lang | safe }}/contact/" }
          {% endif %}
        ]
      }
    ]
  }
  </script>
  {% if page.url | urlFilter('products') and pageType != 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "{{ title | safe }}",
    "url": "https://{{ site.domain | safe }}/{{ lang | safe }}/products/",
    "itemListElement": [
      {% for p in (products[lang] or products[site.fallbackLang]) %}
      {
        "@type": "ListItem",
        "position": {{ loop.index | safe }},
        "name": {{ p.name | tojson | safe }},
        "url": "https://{{ site.domain | safe }}/{{ lang | safe }}/products/{{ productSlugs[p.id] | safe }}/"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
  {% if pageType == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": {{ title | tojson | safe }},
    "description": {{ description | tojson | safe }},
    "url": "https://{{ site.domain | safe }}/{{ lang | safe }}/products/{{ productSlugs[productId] | safe }}/",
    "primaryImageOfPage": { "@type": "ImageObject", "url": "https://{{ site.domain | safe }}{{ productImage | safe }}" },
    "isPartOf": { "@id": "https://{{ site.domain | safe }}/website" }
  }
  </script>
  {% endif %}
  {% if pageType == 'news' and newsSlug %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": {{ title | tojson | safe }},
    "description": {{ description | tojson | safe }},
    {% if newsDate %}"datePublished": {{ newsDate | dateYMD | tojson | safe }},{% endif %}
    "image": ["https://{{ site.domain | safe }}{{ newsImage | default('/assets/img/logo.png') | safe }}"],
    "author": { "@type": "Organization", "name": "{{ site.shortName | safe }}" },
    "publisher": { "@type": "Organization", "name": "{{ site.shortName | safe }}", "logo": { "@type": "ImageObject", "url": "https://{{ site.domain | safe }}/assets/img/logo.png" } },
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://{{ site.domain | safe }}/{{ lang | safe }}/news/{{ newsSlug | safe }}/" }
  }
  </script>
  {% endif %}
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="{{ ('/' + lang + '/') | langUrl(lang) }}">
        <span class="brand-name">{{ site.shortName }}</span>
        <span class="brand-sub">{{ site.nameZh if lang == 'zh' else (site.nameZhTw if lang == 'zh-tw' else site.name) }}</span>
      </a>
      <nav class="main-nav" aria-label="Primary">
        {% for item in site.nav %}
        <a href="{{ item | navUrl(lang) }}" class="{{ 'active' if page.url.startsWith(item | navUrl(lang)) else '' }}">{{ item | navLabel(lang) }}</a>
        {% endfor %}
      </nav>
      <div class="header-tools">
        <label class="lang-switch">
          <span class="visually-hidden">Language</span>
          <select id="lang-select" onchange="location.href=this.value">
            {% for l in site.langs %}
            <option value="{{ page.url | langUrl(l.code) }}" {{ 'selected' if l.code == lang }}>{{ l.native }}</option>
            {% endfor %}
          </select>
        </label>
        <a class="btn btn-whatsapp" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>
        {% set fh = site.footerPerLang[lang] or site.footerPerLang[site.defaultLang] %}
        <button id="chat-toggle" class="btn btn-chat" type="button" aria-expanded="false">💬 {{ fh.aiBtn }}</button>
      </div>
    </div>
  </header>

  <main>
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  <footer class="site-footer">
    {% set f = site.footerPerLang[lang] or site.footerPerLang[site.defaultLang] %}
    <div class="container footer-inner">
      <div>
        <h2>{{ site.nameZh if lang == 'zh' else (site.nameZhTw if lang == 'zh-tw' else site.name) }}</h3>
        <p>{{ site.addressZh if lang == 'zh' else (site.addressZhTw if lang == 'zh-tw' else site.address) }}</p>
        <p>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a> · Tel: {{ site.phone }}</p>
        <p>WeChat: {{ site.wechat }}</p>
      </div>
      <div>
        <h2>{{ f.inquiry }}</h2>
        <p><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp: +86 186 5687 1390</a></p>
        <p><button id="chat-toggle-2" class="link-btn" type="button">💬 {{ f.aiBtn }}</button></p>
        <p><a href="{{ ('/' + lang + '/contact/') | langUrl(lang) }}">{{ f.rfq }}</a></p>
      </div>
      <div>
        <h2>{{ f.quickLinks }}</h2>
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item | navUrl(lang) }}">{{ item | navLabel(lang) }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="container copyright">
      © {{ site.name }}. {{ f.rights }}
    </div>
    <div class="container footer-legal">
      <a href="/{{ lang }}/privacy/">{{ f.privacy }}</a>
    </div>
  </footer>

  <!-- Floating WhatsApp button -->
  <a class="wa-float" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">WA</a>

  <!-- AI Chat widget (primary real-time channel) -->
  <div id="chat-panel" class="chat-panel" hidden>
    <div class="chat-head">
      <span>{{ f.chatPanel }}</span>
      <span class="chat-head-btns">
        <button id="chat-min" class="chat-min" type="button" aria-label="Minimize">—</button>
        <button id="chat-close" class="chat-close" type="button" aria-label="Close">×</button>
      </span>
    </div>
    <div id="chat-body" class="chat-body">
      <div id="chat-log" class="chat-log"></div>
      <form id="chat-form" class="chat-form">
        <input id="chat-input" type="text" autocomplete="off" placeholder="{{ f.chatInput }}" />
        <button type="submit">{{ f.chatSend }}</button>
      </form>
    </div>
  </div>

  <script>window.__sharpenWhatsapp = "{{ site.whatsapp }}"; window.__sharpenChatWelcome = {{ f.chatWelcome | tojson | safe }};</script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/chat.js"></script>
</body>
</html>
