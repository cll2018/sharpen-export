<!doctype html>
<html lang="{{ site.defaultLang }}" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ site.name }}</title>
  <meta name="description" content="{{ site.name }} — diamond/CBN grinding wheels, powder metallurgy high-speed steel, TiNiCo superalloy heat spreaders." />
  <link rel="canonical" href="https://{{ site.domain }}/" />
  {% for l in site.langs %}
  <link rel="alternate" hreflang="{{ l.code }}" href="https://{{ site.domain }}/{{ l.code }}/" />
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="https://{{ site.domain }}/en/" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <style>
    .root-hero { text-align:center; padding:72px 16px 8px; }
    .root-hero .brand-name { font-size:2.4rem; color:#16335b; letter-spacing:.5px; }
    .root-hero h1 { font-size:1.1rem; font-weight:600; color:#c8102e; margin:6px 0 14px; }
    .root-hero .names { color:#444; line-height:1.6; }
    .root-hero .hint { margin-top:18px; color:#777; font-size:.95rem; }
    .lang-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:14px; max-width:920px; margin:28px auto 60px; padding:0 16px; }
    .lang-card { display:block; text-align:center; padding:18px 12px; border:1px solid #e4e4e4; border-radius:10px; text-decoration:none; color:#16335b; font-weight:600; background:#fff; transition:.15s; }
    .lang-card:hover { border-color:#c8102e; color:#c8102e; transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.06); }
    .lang-card small { display:block; font-weight:400; color:#76828f; margin-top:6px; font-size:.78rem; line-height:1.3; }
    .root-foot { text-align:center; color:#9aa4ad; font-size:.82rem; padding-bottom:40px; }
  </style>
</head>
<body>
  <div class="root-hero">
    <div class="brand-name">{{ site.shortName }}</div>
    <h1>Global Supplier of Advanced Grinding &amp; Materials</h1>
    <div class="names">{{ site.name }}<br />{{ site.nameZh }}</div>
    <div class="hint">Please choose your language / 请选择语言</div>
  </div>

  <div class="lang-grid">
    {% for l in site.langs %}
    <a class="lang-card" href="/{{ l.code }}/" lang="{{ l.code }}" dir="{{ l.dir }}">{{ l.native }}<small>{{ l.market }}</small></a>
    {% endfor %}
  </div>

  <div class="root-foot">© {{ site.name }}. All rights reserved.</div>

  <script>
    (function () {
      var supported = [{% for l in site.langs %}"{{ l.code }}",{% endfor %}];
      var def = "{{ site.defaultLang }}";
      var nav = (navigator.language || def).toLowerCase();
      var code = def;
      for (var i = 0; i < supported.length; i++) {
        var c = supported[i];
        if (nav === c || nav.indexOf(c + "-") === 0) { code = c; break; }
      }
      if (code === def && (nav.indexOf("zh") === 0)) code = "zh";
      window.location.replace("/" + code + "/");
    })();
  </script>
</body>
</html>
